{
  "name": "chaos-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "db:check": "tsx scripts/check-db.ts",
    "seed": "tsx scripts/seed.ts",
    "break": "tsx scripts/break.ts",
    "benchmark:query": "tsx scripts/benchmark-query.ts",
    "verify:incident": "tsx scripts/verify-incident.ts",
    "dev": "pnpm --parallel -r --filter \"./apps/*\" run dev"
  },
  "dependencies": {
    "@chaos/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
