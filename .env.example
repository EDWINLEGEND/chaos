# ==============================================================================
# Chaos Demo Environment Variables
# Copy to .env for local configuration
# ==============================================================================

# Local Environment
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/acme
MONGODB_DATABASE=acme

# Service Ports
CHECKOUT_PORT=3001
PAYMENT_PROVIDER_PORT=3002
CHAOS_WEB_PORT=3000

# Inter-Service Communication URLs
CHECKOUT_SERVICE_URL=http://localhost:3001
PAYMENT_PROVIDER_URL=http://localhost:3002
CHAOS_WEB_URL=http://localhost:3000

# GitHub Demo Configuration (Placeholders - do not commit real tokens)
GITHUB_REPO=
GITHUB_TOKEN=
