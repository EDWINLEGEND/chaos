# ==============================================================================
# Chaos Demo Environment Variables
# Copy to .env for local configuration
# ==============================================================================

# Local Environment Mode
NODE_ENV=development

# MongoDB Connection Configuration
# - For local development (direct host execution):
MONGODB_URI=mongodb://127.0.0.1:27017/acme
# - For Docker Compose container networking (when checkout runs inside Docker):
# MONGODB_URI=mongodb://mongodb:27017/acme
MONGODB_DATABASE=acme

# Service Ports
CHECKOUT_PORT=3001
PAYMENT_PROVIDER_PORT=3002
CHAOS_WEB_PORT=3000

# Inter-Service Communication URLs
CHECKOUT_SERVICE_URL=http://localhost:3001
PAYMENT_PROVIDER_URL=http://localhost:3002
CHAOS_WEB_URL=http://localhost:3000

# GitHub Demo Configuration (Placeholders - do not commit real tokens)
GITHUB_REPO=
GITHUB_TOKEN=
